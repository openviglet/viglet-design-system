# pnpm settings for the design system, matching the Shio and Turing workspaces
# so a contributor moving between the three meets one set of rules.

# A real flat node_modules rather than pnpm's symlinked one. This package's
# product is its .d.ts files, and under the symlinked layout TypeScript resolves
# each dependency to its real .pnpm path and writes that path into the emitted
# declarations — dist shipped
#   import { ... } from '../../node_modules/.pnpm/react@19.2.8/node_modules/react'
# which exists in no consumer, so React's types vanished and every callback
# parameter became an implicit any in the product build. `preserveSymlinks` is
# the documented answer and it does fix the emit, but it also makes TypeScript
# treat each resolution as distinct and the package stops type-checking against
# itself. A hoisted linker sidesteps both: the layout npm produced, with pnpm's
# lockfile and store. (scripts/check-dist.mjs guards the emit on every build.)
node-linker=hoisted

# Hoist every transitive dep to the top-level node_modules so platform-specific
# optional natives resolve correctly — esbuild / @tailwindcss/oxide / rolldown
# binaries on Linux CI, etc.
shamefully-hoist=true

# CI/builds should never block on a missing/loose engines entry. Keep 'engines'
# advisory only.
engine-strict=false
